# Required: any long random string
DJANGO_SECRET_KEY=

# True for local development
DJANGO_DEBUG=True

# TMDB API read access token, used by Guess the Movie
# https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Needed when playing through a Cloudflare tunnel (python play.py)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
